# M12 Expense Tracker Monorepo Root Environment Configuration

# Backend API
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/m12_expense_tracker_db
JWT_SECRET=m12_expense_tracker_secure_jwt_secret_key_at_least_32_chars!
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Frontend Web
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://localhost:5000

# Transactional Email (Gmail SMTP with Nodemailer)
# Gmail account and 16-character Google App Password (https://myaccount.google.com/apppasswords)
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-google-app-password
OTP_FROM_EMAIL=your-email@gmail.com
APP_BASE_URL=http://localhost:3000
