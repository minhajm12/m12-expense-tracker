# Finora API Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example for local: mongodb://127.0.0.1:27017/finora_db
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/finora_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/finora_db

# Cryptographic JWT Secret (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS
CORS_ORIGIN=http://localhost:3000
