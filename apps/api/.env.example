# M12 Expense Tracker API Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example for local: mongodb://127.0.0.1:27017/m12_expense_tracker_db
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/m12_expense_tracker_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/m12_expense_tracker_db

# Cryptographic JWT Secret (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS
CORS_ORIGIN=http://localhost:3000

# Transactional Email (Gmail SMTP with Nodemailer)
# Gmail account and 16-character Google App Password (https://myaccount.google.com/apppasswords)
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-google-app-password
OTP_FROM_EMAIL=your-email@gmail.com
