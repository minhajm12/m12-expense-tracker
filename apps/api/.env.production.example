# M12 Expense Tracker API - Production Environment Configuration
NODE_ENV=production
PORT=5000

# MongoDB Atlas Production URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/finora?retryWrites=true&w=majority&appName=FinoraCluster

# Cryptographically Secure JWT Secret (min 32 characters, generated via: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Production Origin (Strict CORS protection)
CORS_ORIGIN=https://m12-expense-tracker.vercel.app

# Transactional Email (Gmail SMTP with Nodemailer)
# Use your Google Account email and a 16-character Google App Password (not your normal Gmail password).
# Generate App Password at: https://myaccount.google.com/apppasswords
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-character-google-app-password
OTP_FROM_EMAIL=your-email@gmail.com
